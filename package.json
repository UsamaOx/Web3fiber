{
  "name": "web3fiber",
  "version": "0.1.1",
  "description": "Interactive visual page editing and 3D blocks for React websites",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./editor": {
      "import": "./dist/editor.js",
      "require": "./dist/editor.cjs"
    },
    "./style.css": "./dist/editor.css"
  },
  "files": [
    "dist",
    "README.md",
    "Poppins-OFL.txt",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run dev --prefix demo",
    "build": "vite build",
    "prepare": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src demo/src tests vite.config.js",
    "preview": "npm run preview --prefix demo",
    "demo:build": "npm run build --prefix demo",
    "demo:preview": "npm run preview --prefix demo"
  },
  "peerDependencies": {
    "@react-three/drei": "^9.122.0 || ^10.0.0",
    "@react-three/fiber": "^8.18.0 || ^9.0.0",
    "react": ">=18.0.0 <20",
    "react-dom": ">=18.0.0 <20",
    "three": ">=0.173.0"
  },
  "peerDependenciesMeta": {
    "@react-three/fiber": {
      "optional": true
    },
    "@react-three/drei": {
      "optional": true
    },
    "three": {
      "optional": true
    }
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "motion": "14.14.0",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@fontsource/poppins": "5.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@testing-library/react": "16.3.3",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "jsdom": "27.0.1",
    "three": "^0.187.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
